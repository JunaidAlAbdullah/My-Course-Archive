            <rdf:Seq>
               <rdf:li>Andrew Syred</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">(c) Andrew Syred / Science Source</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Silver crystals. Colored scanning electron micrograph (SEM) of crystals of silver (symbol Ag, atomic number 47). Silver is a lustrous, white precious metal which has been known since pre-history. Its softness and malleability makes it useful in the production of jewelry and coinage. Silver has a high thermal and electrical conductivity, and so has been used in the electronics industry. Magnification: x805 at 6x7cm size.</rdf:li>
            </rdf:Alt>
         </dc:description>
