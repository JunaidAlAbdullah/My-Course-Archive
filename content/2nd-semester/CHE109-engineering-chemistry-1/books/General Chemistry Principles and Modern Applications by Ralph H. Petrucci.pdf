         <photoshop:Headline>Silver crystals</photoshop:Headline>
         <photoshop:Credit>Andrew Syred</photoshop:Credit>
         <photoshop:Source>SCIENCE SOURCE</photoshop:Source>
         <photoshop:ColorMode>4</photoshop:ColorMode>
