         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">SA7124</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>crystalline silver</rdf:li>
               <rdf:li>element</rdf:li>
               <rdf:li>metal</rdf:li>
               <rdf:li>silver crystal</rdf:li>
               <rdf:li>silver metal</rdf:li>
               <rdf:li>chemistry</rdf:li>
               <rdf:li>compound</rdf:li>
               <rdf:li>scanning electron micrograph</rdf:li>
